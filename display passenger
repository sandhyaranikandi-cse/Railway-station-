void displayPassengers()
{
    int i;
    if (passengerCount == 0)
    {
        printf("No passengers found.\n");
        return;
    }
    printf("\nPassenger Details\n");
    printf("----------------------------------------\n");
    for (i = 0; i < passengerCount; i++)
    {
        printf("ID: %d\n", passengers[i].id);
        printf("Name: %s\n", passengers[i].name);
        printf("Age: %d\n", passengers[i].age);
        printf("Train No: %d\n", passengers[i].trainNo);
        printf("Seat No: %d\n", passengers[i].seatNo);
        printf("----------------------------------------\n");
    }
}
